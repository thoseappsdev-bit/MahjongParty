{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@game/*": ["../../game-core/src/*"],
      "@shared/*": ["../../packages/shared-types/src/*"],
      "@ui/*": ["../../packages/ui/src/*"],
      "@i18n/*": ["../../packages/i18n/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
