{
  "name": "mahjong-party",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "dev:lan": "turbo run dev:lan --parallel --filter=@mahjong/web --filter=@mahjong/server",
    "lint": "turbo run lint",
    "preview:cloudflare": "node scripts/run-with-env.mjs pnpm build && node scripts/run-with-env.mjs wrangler dev",
    "deploy:cloudflare": "node scripts/run-with-env.mjs pnpm build && node scripts/run-with-env.mjs wrangler deploy",
    "check:cloudflare": "node scripts/run-with-env.mjs wrangler deploy --dry-run",
    "sync:cloudflare-secrets": "node scripts/cloudflare-put-supabase-secrets.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "production:check": "node scripts/production-readiness-check.mjs",
    "production:smoke": "node scripts/smoke-production.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260713.1",
    "playwright": "^1.61.1",
    "turbo": "2.10.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.110.0"
  }
}
