# Browser-safe Vite configuration. These values are embedded in the web bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DISCORD_CLIENT_ID=

# Required server-side Supabase configuration for production auth and economy.
# Never expose SERVICE_ROLE or JWT_SECRET through a VITE_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Required server-side Discord OAuth secret. The bot token is optional and is
# only needed for server-side Activity Instance API validation.
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Server-side image provider keys. Keep these only in root .env.
# The backend accepts either OPENAI_API_KEY or CHATGPT_API_KEY.
OPENAI_API_KEY=
CHATGPT_API_KEY=

# The backend accepts FAL_KEY, FAL_AI_API_KEY, or fal_ai_api_key.
FAL_KEY=
FAL_AI_API_KEY=
fal_ai_api_key=

# Optional image defaults.
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Optional direct Postgres connection for server-side jobs/adapters.
SUPABASE_DATABASE_URL=
SUPABASE_DB_URL=

# Real-money purchase verification and rewarded-ad fulfillment are
# intentionally disabled. There is no environment flag that enables them.

# Optional local Cloudflare deploy automation.
# Manual login with `npx wrangler login` is safer for early testing.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
